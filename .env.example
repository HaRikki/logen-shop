PORT=3000
JWT_SECRET=change-me-to-a-long-random-string-32+
ENC_KEY=another-long-random-string-for-encrypting-stock
DB_PATH=./data.db
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=ChangeThisStrongPassword
# Set to 1 for ONE restart to reset the admin password to ADMIN_PASSWORD, then remove it
ADMIN_RESET=
# Supplier (standard SMM panel API v2: action=services|add|status|balance)
SUPPLIER_API_URL=https://supplier.example.com/api/v2
SUPPLIER_API_KEY=
# Payments: your KHQR provider (e.g. khmer-system.com) calls POST /api/payments/webhook with this secret
PAYMENT_WEBHOOK_SECRET=change-me-webhook-secret
# Telegram Mini App (optional)
BOT_TOKEN=
# Telegram login (website button). Client ID/Secret are entered in Admin panel -> Login (BotFather -> Login Widget).
# Optional: force the public site URL used for the redirect (otherwise taken from the Admin panel save).
PUBLIC_URL=
# Telegram admin alerts: your numeric chat id(s), comma separated. Press Start on the bot first. Used with BOT_TOKEN.
ADMIN_CHAT_ID=
